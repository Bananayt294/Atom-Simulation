{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC x64",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "D:/vcpkg/scripts/buildsystems/vcpkg.cmake",

      "environment": {
        "VCPKG_ROOT": "D:/vcpkg",
        "VULKAN_SDK": "D:/Vulkan"
      },

      "cacheVariables": {
        "Vulkan_INCLUDE_DIR": "D:/Vulkan/Include",
        "Vulkan_LIBRARY": "D:/Vulkan/Lib/vulkan-1.lib",

        "Vulkan_volk_LIBRARY": "D:/Vulkan/Lib/volk.lib",
        "Vulkan_volk_DEBUG_LIBRARY": "D:/Vulkan/Lib/volkd.lib",

        "Vulkan_shaderc_combined_LIBRARY": "D:/Vulkan/Lib/shaderc_combined.lib",
        "Vulkan_shaderc_combined_DEBUG_LIBRARY": "D:/Vulkan/Lib/shaderc_combinedd.lib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    }
  ]
}
